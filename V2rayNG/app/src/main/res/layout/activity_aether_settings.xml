<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/srvx_bg_gradient"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Top App Bar / Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="بازگشت"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/srvx_ic_power"
            android:rotation="90"
            app:tint="@color/srvx_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="تنظیمات و لایسنس Aether"
            android:textColor="@color/srvx_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_save_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="ذخیره"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/srvx_ic_check"
            app:tint="@color/srvx_gold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Card 0: Connection Chain Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/srvx_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/srvx_card_stroke"
                app:strokeWidth="1dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/srvx_ic_power"
                            app:tint="@color/srvx_gold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="اتصال از طریق Aether"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_aether_chain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="با فعال‌سازی این گزینه، ترافیک تمام کانفیگ‌ها ابتدا از موتور Aether عبور می‌کند."
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_chain_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rb_chain_masque"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MASQUE (HTTP/3 / QUIC)"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_chain_wg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="WireGuard (Direct Tunnel)"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_chain_gool"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="WARP*2 (Double Hop Anti-DPI)"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1: License & Account -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/srvx_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/srvx_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/srvx_ic_shield"
                            app:tint="@color/srvx_gold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="اکانت و لایسنس اختصاصی"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_account_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/srvx_pill_ping_green"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="رایگان عمومی"
                            android:textColor="@color/srvx_emerald"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="برای افزایش سرعت و ترافیک نامحدود، کلید لایسنس WARP+ یا اکانت سازمانی Zero Trust خود را وارد کنید:"
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <!-- WARP+ Key Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="کلید لایسنس WARP+ (اختیاری)"
                        android:textColor="@color/srvx_gold"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_warp_key"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/srvx_input_field"
                        android:hint="مثلاً: 24-character-license-key"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/srvx_text_primary"
                        android:textColorHint="@color/srvx_text_muted"
                        android:textSize="13sp" />

                    <!-- Zero Trust Team Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="نام تیم Cloudflare Zero Trust"
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_zt_team"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/srvx_input_field"
                        android:hint="your-organization"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/srvx_text_primary"
                        android:textColorHint="@color/srvx_text_muted"
                        android:textSize="13sp" />

                    <!-- Zero Trust Token -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="توکن سرویس سازمانی (Service Token)"
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/et_zt_token"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/srvx_input_field"
                        android:hint="Client Secret / Enrolment Token"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/srvx_text_primary"
                        android:textColorHint="@color/srvx_text_muted"
                        android:textSize="13sp" />

                    <!-- Open Web Panel Button -->
                    <TextView
                        android:id="@+id/btn_open_free_portal"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/srvx_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🌐 ورود به پورتال وب و دریافت لایسنس رایگان"
                        android:textColor="@color/srvx_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Endpoint Scan Mode -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/srvx_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/srvx_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/srvx_ic_speed"
                            app:tint="@color/srvx_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="حالت اسکن اندپوینت (Endpoint Prober)"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="انتخاب سرعت و دقت اسکن IPهای تمیز کلودفلر برای اتصال:"
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_scan_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <RadioButton
                            android:id="@+id/rb_scan_turbo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="⚡ حالت توربو (Turbo - پیش‌فرض) — اتصال آنی زیر ۲ ثانیه"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_scan_balanced"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="⚖️ حالت متعادل (Balanced) — تست متوازن رنج‌های کلودفلر"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rb_scan_thorough"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="🔍 حالت عمیق (Thorough) — اسکن تمام اندپوینت‌ها در اختلال شدید"
                            android:textColor="@color/srvx_text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Advanced Tuning & Reset -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/srvx_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/srvx_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فرگمنت و ضد فیلترینگ پیشرفته"
                        android:textColor="@color/srvx_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="تکنیک تکه‌تکه کردن بسته‌های TLS برای دور زدن فیلترینگ فعال است."
                        android:textColor="@color/srvx_text_secondary"
                        android:textSize="12sp" />

                    <!-- Rebuild / Reset Free Configs Action -->
                    <TextView
                        android:id="@+id/btn_rebuild_configs"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/srvx_card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🔄 بازسازی و به‌روزرسانی ۳ کانفیگ Aether"
                        android:textColor="@color/srvx_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Save Button -->
            <TextView
                android:id="@+id/btn_save_bottom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/srvx_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="ذخیره و اعمال تنظیمات"
                android:textColor="#090C19"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:background="@drawable/srvx_bg_gradient"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="SRVX"
        android:src="@drawable/srvx_medallion" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.18"
        android:text="SRVX"
        android:textColor="@color/srvx_gold"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="شبکه امن و پرسرعت"
        android:textColor="@color/srvx_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
